# Copy this file to `.env` (same folder) and fill in values. `.env` is never committed.

# Sentry crash/performance reporting. Leave empty to keep Sentry off.
# Where to find it: docs/SENTRY.md
EXPO_PUBLIC_SENTRY_DSN=

# Search server (Photon). Leave empty to use Komoot's free public server, which is
# fine for testing on our own phones. Set it to our own server before sharing the app.
# See docs/SEARCH.md.
EXPO_PUBLIC_PHOTON_URL=

# Routing server (Valhalla). Leave empty to use the free public FOSSGIS server, which is
# fine for testing on our own phones. Set it to our own server before sharing the app.
# See docs/ROUTING.md.
EXPO_PUBLIC_VALHALLA_URL=
